<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Inngest.AspNetCore</RootNamespace>
    <Description>ASP.NET Core hosting for the Inngest .NET SDK: MapInngest serves sync, introspection and invocation, and a health check tells readiness probes whether the app can work with Inngest.</Description>
    <!-- The package uses its own durable endpoint API, which is marked experimental for its users. -->
    <NoWarn>$(NoWarn);INNGEST001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inngest\Inngest.csproj" />
    <!-- MapInngestWebhook is the ASP.NET Core host of the verifiers and the receiver, which know nothing of ASP.NET Core. -->
    <ProjectReference Include="..\Inngest.Webhooks\Inngest.Webhooks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inngest.AzureFunctions" />
    <InternalsVisibleTo Include="Inngest.Tests" />
    <InternalsVisibleTo Include="Inngest.IntegrationTests" />
  </ItemGroup>
</Project>
