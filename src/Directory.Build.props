<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- .NET 8 leaves support on 2026-11-10. Apps keep running on it for a while after, so the packages keep it. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <Authors>inngest-dotnet contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>inngest;durable-execution;workflows;background-jobs;queues</PackageTags>
    <Copyright>Copyright 2026 the inngest-dotnet contributors. Portions copyright 2022 Inngest Inc.</Copyright>
    <PackageProjectUrl>https://damikun.github.io/inngest-dotnet/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/damikun/inngest-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Source Link ships with the SDK: debuggers step into the exact sources of a package build. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- dotnet pack fails on a change that would break code built against the last release on nuget.org. Raise the
         baseline to each new release once it is published. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- nuget.org renders no HTML and no images from the repository, so the packages carry a plain README of their own. -->
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <!-- The site's mark (site/public/favicon.svg) at the 128 px nuget.org recommends, with transparent corners. -->
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
