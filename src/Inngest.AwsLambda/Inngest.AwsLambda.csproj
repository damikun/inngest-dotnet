<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Inngest.AwsLambda</RootNamespace>
    <Description>AWS Lambda hosting for the Inngest .NET SDK: serves sync, introspection and invocation from API Gateway REST and HTTP APIs and Lambda function URLs, as a managed runtime function or a Native AOT executable.</Description>
    <PackageTags>$(PackageTags);aws;lambda;serverless;api-gateway</PackageTags>
    <!-- No release includes this package yet. Remove this once the baseline in src/Directory.Build.props names one that does. -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" />
    <PackageReference Include="Amazon.Lambda.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inngest\Inngest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inngest.Tests" />
  </ItemGroup>
</Project>
