<Project>
  <!-- DisableInngestSourceGenerator=true takes the generator and the analyzers of this package out of a build, for the case
       that one of them gets in the way. The package then does nothing at compile time; the SDK itself is not affected. -->
  <Target Name="_InngestRemoveCompilerExtensions"
          Condition="'$(DisableInngestSourceGenerator)' == 'true'"
          AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Inngest'" />
    </ItemGroup>
  </Target>
</Project>
