<Project>
  <!-- DisableInngestAnalyzers=true takes everything this package runs in the compiler out of a build, the generator and the
       analyzers, for the case that one of them gets in the way. The package then does nothing at compile time; the library
       itself is not affected. -->
  <Target Name="_InngestRemoveAnalyzers"
          Condition="'$(DisableInngestAnalyzers)' == 'true'"
          AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Inngest'" />
    </ItemGroup>
  </Target>
</Project>
