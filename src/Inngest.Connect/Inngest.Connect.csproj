<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Inngest.Connect</RootNamespace>
    <Description>Connect for the Inngest .NET SDK: runs functions in a worker that holds an outbound WebSocket to Inngest, with no HTTP endpoint to expose.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the message types; the gateway protocol has no gRPC services on the worker side. -->
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="None" Access="Internal" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inngest\Inngest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inngest.Tests" />
    <InternalsVisibleTo Include="Inngest.IntegrationTests" />
  </ItemGroup>
</Project>
