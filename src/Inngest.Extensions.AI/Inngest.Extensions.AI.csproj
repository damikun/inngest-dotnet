<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Inngest.Extensions.AI</RootNamespace>
    <Description>Durable chat clients for the Inngest .NET SDK: a Microsoft.Extensions.AI IChatClient whose model calls and tool calls are steps of the Inngest run they are made in, so a replay never calls the model or a tool twice.</Description>
    <PackageTags>$(PackageTags);ai;llm;chat;microsoft-extensions-ai</PackageTags>
    <!-- No release includes this package yet. Remove this once the baseline in src/Directory.Build.props names one that does. -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <!-- ChatClientBuilder and FunctionInvokingChatClient live here, not in the abstractions, which this brings in. It has builds
         for net8.0 and net10.0. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- The generator behind the log messages. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Inngest\Inngest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Inngest.Tests" />
  </ItemGroup>
</Project>
