<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The tests of this package have a project of their own, because Microsoft.Extensions.AI brings System.Text.Json 10 to
         net8.0, and Inngest.Tests should keep running on the System.Text.Json 8 that most net8.0 apps have. As there, tests run
         on the latest runtime by default; build with -p:TestAllFrameworks=true to also produce the net8.0 test app. -->
    <TargetFrameworks>$(LatestTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestAllFrameworks)' == 'true'">$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- .NET 8 leaves support on 2026-11-10; newer SDKs would otherwise warn, which fails the build. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
    <!-- .NET 8 has no System.Threading.Lock; the helpers only use it with the lock statement, which an object serves as well. -->
    <Using Include="System.Object" Alias="Lock" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Inngest\Inngest.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Extensions.AI\Inngest.Extensions.AI.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Testing\Inngest.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The harness of Inngest.Tests that the tests here use too: the real engine in memory, the calls Inngest makes to it, and
         the hosts for functions. They keep their namespaces. -->
    <Compile Include="..\Inngest.Tests\Execution\EngineHost.cs" Link="Shared\EngineHost.cs" />
    <Compile Include="..\Inngest.Tests\Checkpointing\Checkpointed.cs" Link="Shared\Checkpointed.cs" />
    <Compile Include="..\Inngest.Tests\Checkpointing\FakeCheckpointApi.cs" Link="Shared\FakeCheckpointApi.cs" />
    <Compile Include="..\Inngest.Tests\Checkpointing\FakeEndpointCheckpointApi.cs" Link="Shared\FakeEndpointCheckpointApi.cs" />
    <Compile Include="..\Inngest.Tests\Testing\TestHosts.cs" Link="Shared\TestHosts.cs" />
  </ItemGroup>
</Project>
