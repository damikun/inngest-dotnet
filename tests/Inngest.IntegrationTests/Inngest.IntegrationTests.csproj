<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(LatestTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Tests pass TestContext.Current.CancellationToken through IntegrationTest.Cancellation, which xUnit1069 cannot see. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1069;INNGEST001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.TestUtilities" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fakes of the worker's request, response and context that the unit tests of the Azure Functions package use. Here they
         let the app stand in for the Functions host. -->
    <Compile Include="..\Inngest.Tests\AzureFunctions\Fakes\*.cs" LinkBase="AzureFunctions\Fakes" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Inngest\Inngest.csproj" />
    <ProjectReference Include="..\..\src\Inngest.AspNetCore\Inngest.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Inngest.AwsLambda\Inngest.AwsLambda.csproj" />
    <ProjectReference Include="..\..\src\Inngest.AzureFunctions\Inngest.AzureFunctions.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Blazor\Inngest.Blazor.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Connect\Inngest.Connect.csproj" />
    <ProjectReference Include="..\..\src\Inngest.EntityFrameworkCore\Inngest.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Extensions.AI\Inngest.Extensions.AI.csproj" />
    <ProjectReference Include="..\..\src\Inngest.SignalR\Inngest.SignalR.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Testing.Containers\Inngest.Testing.Containers.csproj" />
    <ProjectReference Include="..\..\src\Inngest.Testing.Containers.AspNetCore\Inngest.Testing.Containers.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Inngest.UserContext\Inngest.UserContext.csproj" />
    <ProjectReference Include="..\..\src\Inngest.UserContext.AspNetCore\Inngest.UserContext.AspNetCore.csproj" />
    <!-- The app that the WebApplicationFactory tests of Inngest.Testing.Containers.AspNetCore run. -->
    <ProjectReference Include="..\..\samples\Inngest.Sample\Inngest.Sample.csproj" />
  </ItemGroup>
</Project>
