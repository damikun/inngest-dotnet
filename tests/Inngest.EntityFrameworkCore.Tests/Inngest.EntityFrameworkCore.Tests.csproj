<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The tests run on the latest runtime by default. Build with -p:TestAllFrameworks=true to also produce the net8.0 test
         app, which runs on EF Core 8 like the net8.0 build of the package. -->
    <TargetFrameworks>$(LatestTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestAllFrameworks)' == 'true'">$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- .NET 8 leaves support on 2026-11-10; newer SDKs would otherwise warn, which fails the build. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Inngest\Inngest.csproj" />
    <ProjectReference Include="..\..\src\Inngest.EntityFrameworkCore\Inngest.EntityFrameworkCore.csproj" />
  </ItemGroup>
</Project>
