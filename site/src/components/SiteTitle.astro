---
// A plain text wordmark. The site uses no logo of its own and none of Inngest's marks.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark" translate="no">
  <span class="base">inngest</span><span class="suffix">-dotnet</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--__sl-font-mono);
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    /* Fourteen monospace characters: a fixed width keeps the search box still while the font loads. */
    width: 8.3em;
  }
  .base {
    color: var(--sl-color-white);
  }
  .suffix {
    color: var(--sl-color-text-accent);
  }
  .wordmark:hover .base {
    color: var(--sl-color-text-accent);
  }
</style>
