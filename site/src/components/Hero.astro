---
import { LinkButton } from '@astrojs/starlight/components';
import HeroSteps from './landing/HeroSteps.astro';

// The hero of splash pages: an eyebrow, a large display title, the tagline and the actions, centered on a band with a
// coral glow and a fine grain, after inngest.com. The landing page adds a row of facts.
const { entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
const isHome = entry.id === 'index' || entry.id === '';

const facts = ['.NET 8 and .NET 10', 'ASP.NET Core or Connect', 'Native AOT', '1,596 unit tests', '196 end-to-end tests', 'Apache 2.0'];
---

<div class:list={['landing-hero', 'not-content', { home: isHome }]}>
  <div class="copy">
  {isHome && <p class="eyebrow">Inngest SDK for .NET</p>}
  <h1 id="_top" data-page-title class="idn-display" set:html={title} />
  {tagline && <p class="lead" set:html={tagline} />}
  {
    actions.length > 0 && (
      <div class="actions">
        {actions.map(({ attrs, icon, link: href, text, variant }) => (
          <LinkButton {href} {variant} icon={icon?.type === 'icon' ? icon.name : undefined} {...attrs}>
            {text}
          </LinkButton>
        ))}
      </div>
    )
  }
  </div>
  {
    isHome && (
      <>
        <div class="visual">
          <HeroSteps />
        </div>
        <ul class="facts" aria-label="At a glance">
          {facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </>
    )
  }
</div>

<style>
  .landing-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4.5rem);
    text-align: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .visual {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Below 1024px the illustration follows the buttons. From 1024px the copy and the facts sit on the left, centered
     beside the illustration. */
  @media (min-width: 64rem) {
    .landing-hero.home {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas: '. visual' 'copy visual' 'facts visual' '. visual';
      column-gap: clamp(2.5rem, 4vw, 4.5rem);
      row-gap: 0;
      text-align: start;
    }
    .home .copy {
      grid-area: copy;
      align-items: flex-start;
    }
    .home .visual {
      grid-area: visual;
      align-self: center;
      justify-content: flex-end;
    }
    .home .facts {
      grid-area: facts;
      margin-top: 2rem;
    }
    .home .actions,
    .home .facts {
      justify-content: flex-start;
    }
    .home h1 {
      font-size: clamp(3.5rem, 1rem + 4.6vw, 6.25rem);
    }
  }

  /* The band reaches the edges of the window; main clips it so it never causes sideways scrolling. */
  .landing-hero::before,
  .landing-hero::after {
    content: '';
    position: absolute;
    inset: calc(-1.5rem - 1px) calc(50% - 50vw) 0;
    z-index: -1;
    pointer-events: none;
  }

  .landing-hero::before {
    background:
      radial-gradient(48rem 26rem at 50% -6rem, color-mix(in srgb, var(--idn-coral) 26%, transparent), transparent 72%),
      var(--sl-color-black);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .landing-hero::after {
    background-image: var(--idn-grain);
    opacity: var(--idn-grain-opacity);
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.2rem + 6.4vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .lead {
    margin: 0;
    max-width: 44rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.55vw, 1.3125rem);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-top: 0.5rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .facts li::before {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-inline-end: 0.5rem;
    border-radius: 50%;
    background-color: var(--idn-coral);
    vertical-align: 0.1em;
  }
</style>
