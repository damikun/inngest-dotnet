---
// The ways to start the Inngest dev server, as tabs that remember the reader's pick across pages. The commands are in
// src/data/dev-server.ts, where the Markdown copies of the pages take them from too.
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import { devServerTabs } from '../data/dev-server';

interface Props {
  // For a Connect worker: the dev server stops looking for HTTP apps, and the worker dials in on port 8289.
  connect?: boolean;
}
const { connect = false } = Astro.props;
const tabs = devServerTabs(connect);
---

<Tabs syncKey="devserver">
  {
    tabs.map((tab) => (
      <TabItem label={tab.label}>
        {tab.blocks.map((block) => (
          <Code lang={block.lang} title={block.title} wrap={block.wrap} code={block.code} />
        ))}
        {tab.note && <p set:html={tab.note} />}
      </TabItem>
    ))
  }
</Tabs>
