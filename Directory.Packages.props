<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <!-- The event types of API Gateway and function URLs. The 3.x line has builds for net8.0 and net10.0 and no dependencies. -->
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.1" />
    <!-- ILambdaContext. -->
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.4.0" />
    <!-- The first 2.x release of the isolated worker, so that an app keeps the worker version it has: NuGet raises this to
         whatever the app's Microsoft.Azure.Functions.Worker needs. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Core" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <!-- Versioned with ASP.NET Core, whose 10.0 packages have no net8.0 build; net8.0 gets the version its framework ships. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Entity Framework Core has one major version per runtime, like ASP.NET Core, and its 10.0 packages have no net8.0 build. Each
         build of Inngest.EntityFrameworkCore stays on the line it is compiled against, because ExecuteUpdate moved from the Relational
         assembly to the core assembly in EF Core 9. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Versioned with ASP.NET Core like the health checks, so net8.0 gets the version its framework ships. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <!-- The newest stable release, with builds for net8.0 and net10.0. It brings in Microsoft.Extensions.AI.Abstractions. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- XSalsa20, Poly1305 and BLAKE2b for Inngest.Encryption. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- The first line built on System.Diagnostics.DiagnosticSource 10, which the SDK already depends on. -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <!-- The newest stable release. It has builds for net8.0 and net10.0, and needs no other packages on either. -->
    <PackageVersion Include="Sentry" Version="6.12.1" />
    <!-- Versioned with ASP.NET Core. The 10.0 package builds for net10.0 and netstandard2.0, which net8.0 would fall back to
         with extra dependencies, so net8.0 gets the version its framework ships. Neither has a framework reference. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <!-- The current stable Aspire. Its one build targets net8.0, which every newer AppHost uses as well. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="Compiler extensions">
    <!-- Roslyn 4.8 is the compiler of the first .NET 8 SDK and of Visual Studio 17.8, the oldest tooling that builds for
         net8.0, which is the oldest runtime the packages target. A generator or analyzer loads into a compiler of its own
         Roslyn version or a newer one, so building against 4.8 covers every compiler that can build an app for the SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <!-- The rules for compiler extensions: RS1035 banned APIs, RS1038 no Workspaces, RS2008 release tracking. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Amazon.Lambda.TestUtilities" Version="4.3.0" />
    <!-- Renders Blazor components in tests. Its 2.x line has builds for net8.0 and net10.0 and works with xunit v3 without an adapter package. -->
    <PackageVersion Include="bunit" Version="2.13.3" />
    <!-- The SignalR client, its MessagePack protocol and the Redis backplane are versioned with ASP.NET Core, as TestHost is below. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- TestHost is versioned with ASP.NET Core and its 10.0 packages have no net8.0 build. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Only the .NET 10 package has WebApplicationFactory.UseKestrel, which Inngest.Testing.Containers.AspNetCore needs, so
         unlike TestHost there is no net8.0 version. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Only for a unit test that checks, against the worker's own code, the key under which its ASP.NET Core integration keeps the HttpContext. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <!-- The SQLite provider of the EF Core line that Inngest.EntityFrameworkCore is built on, for each runtime. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The Roslyn testing packages and the reference assemblies of net10.0 that the compilations under test are built against. -->
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    <!-- The version of this package that the Roslyn testing packages bring in has known vulnerabilities. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- The AppHost projects (tests/Inngest.Aspire.Hosting.Tests and samples/Inngest.Sample.AppHost) get Aspire.AppHost.Sdk
         at the version in global.json, which adds the orchestrator and dashboard packages of the version of
         Aspire.Hosting.AppHost for the machine's runtime. Raise all of these together; a test checks that they agree. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
  </ItemGroup>
  <ItemGroup Label="Samples">
    <!-- The Native AOT Lambda sample: the loop that takes events from Lambda, the source-generated serializer that reads
         them (which the unit tests also read events with, as the managed runtime does) and the console logger. -->
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.3.0" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
  </ItemGroup>
</Project>
